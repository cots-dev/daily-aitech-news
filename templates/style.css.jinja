:root {
  --bg: #f4f8fd;
  --card-bg: #ffffff;
  --text: #101a33;
  --text-muted: #64748b;
  --blue: #2563eb;
  --blue-dark: #1d4ed8;
  --orange: #f97316;
  --border: #dbe4f3;
  --divider: #e6ecf6;
  --unread: #101a33;
  --visited: #9aa6bb;
  --star: #f97316;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0b1220;
    --card-bg: #131c30;
    --text: #eef2f9;
    --text-muted: #93a0b8;
    --blue: #60a5fa;
    --blue-dark: #3b82f6;
    --orange: #fb923c;
    --border: #24314c;
    --divider: #1c273e;
    --unread: #eef2f9;
    --visited: #5b6780;
    --star: #fb923c;
  }
}

* { box-sizing: border-box; }

body {
  position: relative;
  margin: 0;
  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", sans-serif;
  line-height: 1.6;
}
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image: url("network-corner-tl.svg"), url("network-corner-br.svg");
  background-repeat: no-repeat, no-repeat;
  background-position: top -30px left -30px, bottom -30px right -30px;
  background-size: 220px 178px, 360px 296px;
  opacity: 0.65;
}
@media (min-width: 720px) {
  body::before {
    background-size: 300px 242px, 480px 395px;
  }
}

.site-header {
  position: relative;
  z-index: 1;
  padding: 18px 16px;
  border-bottom: 3px solid var(--blue);
  background: rgba(255, 255, 255, 0.5);
}
@media (prefers-color-scheme: dark) {
  .site-header { background: rgba(11, 18, 32, 0.5); }
}
.site-header h1 {
  margin: 0;
  font-size: 1.7rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--blue-dark);
}
.site-header .subtitle {
  margin: 6px 0 0;
  color: var(--text-muted);
  font-size: 0.85rem;
  line-height: 1.5;
}
.site-header .header-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-top: 10px;
}
.site-header .date {
  color: var(--orange);
  font-size: 0.85rem;
  font-weight: 700;
}

.tab-input { display: none; }

.tabs-wrapper { position: relative; z-index: 1; }

.tabbar {
  display: flex;
  overflow-x: auto;
  gap: 8px;
  padding: 12px;
  background: var(--card-bg);
  border-bottom: 1px solid var(--divider);
  -webkit-overflow-scrolling: touch;
}
.tab-label {
  flex: 0 0 auto;
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--blue-dark);
  cursor: pointer;
  white-space: nowrap;
  border: 2px solid var(--border);
  background: var(--card-bg);
  user-select: none;
}

.panels {
  max-width: 720px;
  margin: 0 auto;
  background: rgba(255, 255, 255, 0.85);
}
@media (prefers-color-scheme: dark) {
  .panels { background: rgba(11, 18, 32, 0.78); }
}
.panel { display: none; padding: 8px 16px 40px; }

.article-list { list-style: none; margin: 0; padding: 0; }
.article-list li {
  padding: 12px 0;
  border-bottom: 1px solid var(--divider);
}
.article-list li.empty {
  color: var(--text-muted);
  font-size: 0.9rem;
}

.article-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.article-text { flex: 1; min-width: 0; }
.thumb-link { flex-shrink: 0; }
.article-thumb {
  width: 72px;
  height: 72px;
  object-fit: cover;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--card-bg);
  display: block;
}

.bookmark-btn {
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  padding: 0;
  border: none;
  background: none;
  font-size: 1.3rem;
  line-height: 1;
  color: var(--text-muted);
  cursor: pointer;
}
.bookmark-btn.is-bookmarked { color: var(--star); }

.article-link:link {
  color: var(--unread);
  font-weight: 700;
  text-decoration: none;
  font-size: 1rem;
}
.article-link:visited {
  color: var(--visited);
  font-weight: 400;
}
.article-link:hover { text-decoration: underline; color: var(--blue); }

.meta {
  margin-top: 4px;
  font-size: 0.8rem;
  color: var(--text-muted);
}

.site-footer {
  position: relative;
  z-index: 1;
  max-width: 720px;
  margin: 0 auto;
  padding: 24px 16px 16px;
  background: rgba(255, 255, 255, 0.92);
  border-top: 1px solid var(--divider);
}
@media (prefers-color-scheme: dark) {
  .site-footer { background: rgba(11, 18, 32, 0.86); }
}
.site-footer h2 { font-size: 1rem; font-weight: 800; color: var(--blue-dark); }
.prompt-links { padding-left: 20px; font-size: 0.9rem; color: var(--text-muted); }
.prompt-links a { color: var(--blue); font-weight: 700; }

.copyright {
  position: relative;
  z-index: 1;
  max-width: 720px;
  margin: 0 auto;
  padding: 12px 16px 32px;
  font-size: 0.78rem;
  color: var(--text-muted);
  text-align: center;
  background: rgba(255, 255, 255, 0.92);
}
@media (prefers-color-scheme: dark) {
  .copyright { background: rgba(11, 18, 32, 0.86); }
}

#tab-all:checked ~ .panels #panel-all { display: block; }
{% for c in categories %}#tab-{{ c.id }}:checked ~ .panels #panel-{{ c.id }} { display: block; }
{% endfor %}#tab-bookmark:checked ~ .panels #panel-bookmark { display: block; }

/* 選択中タブのハイライト（オレンジ塗り） */
#tab-all:checked ~ .tabbar label[for="tab-all"] {
  background: var(--orange);
  color: #ffffff;
  border-color: var(--orange);
}
{% for c in categories %}#tab-{{ c.id }}:checked ~ .tabbar label[for="tab-{{ c.id }}"] {
  background: var(--orange);
  color: #ffffff;
  border-color: var(--orange);
}
{% endfor %}#tab-bookmark:checked ~ .tabbar label[for="tab-bookmark"] {
  background: var(--orange);
  color: #ffffff;
  border-color: var(--orange);
}
