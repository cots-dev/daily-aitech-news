{#-
  デザインシステム「Navy Diagonal」に合わせた配色。
  ライト＝白地にネイビー（navy-700）、アクセントはティール（teal-600）。
  ダーク＝深いネイビー地に白文字、アクセントはミント（mint-200）。
  背景の斜め面（.backdrop）は記事一覧の後ろから透けて見えるよう、一覧の面を半透明にしている。
-#}
:root {
  --bg: #ffffff;
  --card-bg: #ffffff;
  --raised: #f0f5f9;
  --text: #232323;
  --text-secondary: #3f4750;
  --text-muted: #525a63;
  --primary: #013f78;
  --primary-hover: #04325f;
  --on-primary: #ffffff;
  --accent: #1e7f85;
  --on-accent: #ffffff;
  --star-on: #1e7f85;
  --hairline: #d5dce5;
  --unread: #232323;
  --visited: #848c96;
  --title: #013f78;
  --header-bg: rgba(255, 255, 255, 0.94);
  --tabbar-bg: rgba(255, 255, 255, 0.9);
  --panel-bg: rgba(255, 255, 255, 0.8);
  --menu-shadow: 0 8px 24px rgba(1, 63, 120, 0.12);
  --bd-navy: #013f78;
  --bd-navy-low: #1f648c;
  --bd-mint: #addee2;
  --bd-charcoal: #232323;
  --cut-navy: #013f78;
  --cut-mint: #addee2;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
  --font-jp: "Noto Sans JP", "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;
  --font-en: "Barlow Condensed", "Arial Narrow", "Noto Sans JP", sans-serif;
  color-scheme: light;
}
{#- ダーク配色。OS設定（利用者が未選択のとき）と切替ボタン（data-theme="dark"）の両方で使う -#}
{% set dark_tokens %}
    --bg: #021a33;
    --card-bg: #04284d;
    --raised: #0a3560;
    --text: #f2f5f9;
    --text-secondary: #c8d4e3;
    --text-muted: #a9bcd4;
    --primary: #addee2;
    --primary-hover: #c9ecef;
    --on-primary: #013f78;
    --accent: #addee2;
    --on-accent: #013f78;
    --star-on: #addee2;
    --hairline: rgba(255, 255, 255, 0.14);
    --unread: #f2f5f9;
    --visited: #7d93ae;
    --title: #ffffff;
    --header-bg: rgba(2, 26, 51, 0.94);
    --tabbar-bg: rgba(2, 26, 51, 0.9);
    --panel-bg: rgba(2, 26, 51, 0.78);
    --menu-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    --bd-navy: #013f78;
    --bd-navy-low: #1f648c;
    --bd-mint: #2b9ca2;
    --bd-charcoal: #0b1420;
    --cut-navy: #013f78;
    --cut-mint: #addee2;
    color-scheme: dark;
{% endset %}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
{{- dark_tokens }}  }
}
:root[data-theme="dark"] {
{{- dark_tokens }}}

* { box-sizing: border-box; }

body {
  position: relative;
  margin: 0;
  background-color: var(--bg);
  color: var(--text);
  font-family: var(--font-jp);
  line-height: 1.6;
}

a, button, .tab-label, .menu-item {
  transition: color 150ms var(--ease), background-color 150ms var(--ease), border-color 150ms var(--ease);
}

/* ---- 背景の斜め面（すべて45°。正方形を対角線で切った三角形） ---- */
.backdrop {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}
.backdrop span { position: absolute; display: block; aspect-ratio: 1 / 1; }
/* 右下から立ち上がるネイビーの大面 */
.bd-navy {
  right: 0;
  bottom: 0;
  width: clamp(360px, 62vmax, 980px);
  background: var(--bd-navy);
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}
/* ネイビーの斜辺に沿って右からのぞくミント */
.bd-mint {
  right: 0;
  top: 34vh;
  width: clamp(120px, 18vmax, 280px);
  background: var(--bd-mint);
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}
/* 左下のチャコール */
.bd-charcoal {
  left: 0;
  bottom: 0;
  width: clamp(160px, 26vmax, 420px);
  background: var(--bd-charcoal);
  clip-path: polygon(0 0, 100% 100%, 0 100%);
}
/* 左上の淡いネイビー（ヘッダーの下から少しだけ見える） */
.bd-navy-low {
  left: 0;
  top: 0;
  width: clamp(200px, 34vmax, 560px);
  background: var(--bd-navy-low);
  clip-path: polygon(0 0, 100% 0, 0 100%);
  opacity: 0.85;
}

/* ---- ヘッダー ---- */
.site-header {
  position: relative;
  z-index: 3;
  padding: 20px 16px 16px;
  border-bottom: 1px solid var(--hairline);
  background: var(--header-bg);
}
/* 右下の斜めカット（ネイビーの三角＋ミントの三角） */
.header-cut,
.header-cut::before {
  position: absolute;
  bottom: 0;
  aspect-ratio: 1 / 1;
  pointer-events: none;
}
.header-cut {
  right: 0;
  width: 72px;
  background: var(--cut-navy);
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}
.header-cut::before {
  content: "";
  right: 0;
  width: 36px;
  background: var(--cut-mint);
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
  z-index: 1;
}
.header-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.site-title {
  margin: 0;
  font-family: var(--font-en);
  font-size: 2rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  line-height: 1.1;
  text-transform: uppercase;
}
.site-title a {
  color: var(--title);
  text-decoration: none;
}
.site-header .subtitle {
  position: relative;
  z-index: 1;
  margin: 8px 0 0;
  padding-right: 64px;
  color: var(--text-secondary);
  font-size: 0.8125rem;
  letter-spacing: 0.04em;
  line-height: 1.7;
}
.site-header .header-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-top: 8px;
}
.site-header .date {
  display: inline-flex;
  align-items: baseline;
  gap: 8px;
  color: var(--text);
  font-size: 0.8125rem;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "palt";
}
.date-label {
  font-family: var(--font-en);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: var(--primary);
}

/* ---- メニュー（<details>で開閉。JSなしでも動く） ---- */
.site-menu { position: relative; flex-shrink: 0; }
.header-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.icon-button {
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  padding: 0;
  border-radius: 0;
  border: 1px solid var(--hairline);
  background: var(--card-bg);
  color: var(--primary);
  cursor: pointer;
}
.icon-button:hover { background: var(--raised); }
.icon-button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* テーマ切替：いまライトなら月（ダークへ）、ダークなら太陽（ライトへ）を表示 */
.theme-toggle .icon-sun { display: none; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .theme-toggle .icon-sun { display: block; }
  :root:not([data-theme="light"]) .theme-toggle .icon-moon { display: none; }
}
:root[data-theme="dark"] .theme-toggle .icon-sun { display: block; }
:root[data-theme="dark"] .theme-toggle .icon-moon { display: none; }

.menu-button::-webkit-details-marker { display: none; }
.site-menu .icon-close { display: none; }
.site-menu[open] .icon-open { display: none; }
.site-menu[open] .icon-close { display: block; }
.site-menu[open] .menu-button {
  background: var(--primary);
  border-color: var(--primary);
  color: var(--on-primary);
}
.menu-panel {
  position: absolute;
  right: 0;
  top: calc(100% + 8px);
  width: 248px;
  max-width: calc(100vw - 32px);
  background: var(--card-bg);
  border: 1px solid var(--hairline);
  border-top: 3px solid var(--primary);
  border-radius: 0;
  box-shadow: var(--menu-shadow);
  z-index: 10;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  font-size: 0.875rem;
  letter-spacing: 0.04em;
  color: var(--text);
  text-decoration: none;
  border-bottom: 1px solid var(--hairline);
}
.menu-item:last-child { border-bottom: none; }
.menu-item::after { content: "›"; color: var(--text-muted); }
.menu-item:hover, .menu-item:focus-visible { background: var(--raised); outline: none; }
.menu-item-top { font-weight: 500; }
.menu-item[aria-current="page"] { color: var(--primary); font-weight: 500; }

/* ---- タブ ---- */
.tab-input { display: none; }

.tabs-wrapper { position: relative; z-index: 1; }

.tabbar {
  position: relative;
  z-index: 2;
  display: flex;
  overflow-x: auto;
  gap: 8px;
  padding: 12px 16px;
  background: var(--tabbar-bg);
  border-bottom: 1px solid var(--hairline);
  -webkit-overflow-scrolling: touch;
}
.tab-label {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 32px;
  padding: 0 16px;
  border-radius: 0;
  font-size: 0.8125rem;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--text);
  cursor: pointer;
  white-space: nowrap;
  border: 1px solid var(--hairline);
  background: var(--card-bg);
  user-select: none;
}
.tab-label:hover { color: var(--primary); border-color: var(--primary); }

/* ---- 記事一覧 ---- */
.panels {
  position: relative;
  z-index: 1;
  max-width: 760px;
  margin: 0 auto;
  background: var(--panel-bg);
}
.panel { display: none; padding: 8px 20px 40px; }

.article-list { list-style: none; margin: 0; padding: 0; }
.article-list li {
  padding: 16px 0;
  border-bottom: 1px solid var(--hairline);
}
.article-list li.empty {
  color: var(--text-muted);
  font-size: 0.875rem;
}

.article-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.article-text { flex: 1; min-width: 0; }
/* サムネイルと☆を横に並べ、☆はどの記事でも同じ列に置く */
.article-side {
  display: flex;
  align-items: flex-start;
  gap: 4px;
  flex-shrink: 0;
}
.thumb-link { display: block; }
.article-thumb {
  width: 72px;
  height: 72px;
  object-fit: cover;
  border-radius: 0;
  border: 1px solid var(--hairline);
  background: var(--card-bg);
  display: block;
}

.bookmark-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  margin-top: -4px;
  padding: 0;
  border: none;
  border-radius: 0;
  background: none;
  color: var(--text-muted);
  cursor: pointer;
}
.bookmark-btn .star-icon { fill: none; stroke: currentColor; }
.bookmark-btn:hover { color: var(--primary); }
.bookmark-btn.is-bookmarked { color: var(--star-on); }
.bookmark-btn.is-bookmarked .star-icon { fill: currentColor; }
.bookmark-btn:active { transform: scale(0.96); }
.bookmark-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.article-link:link {
  color: var(--unread);
  font-weight: 500;
  text-decoration: none;
  font-size: 1rem;
  letter-spacing: 0.02em;
  line-height: 1.65;
}
.article-link:visited {
  color: var(--visited);
  font-weight: 400;
}
.article-link:hover { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }

.meta {
  margin-top: 4px;
  font-size: 0.75rem;
  color: var(--text-muted);
  letter-spacing: 0.04em;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "palt";
}
.badges { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 4px; }
.badge {
  display: inline-block;
  padding: 0 8px;
  border-radius: 0;
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  line-height: 20px;
}
.badge-howto { background: var(--accent); color: var(--on-accent); }
.badge-en { border: 1px solid var(--hairline); color: var(--text-secondary); line-height: 18px; }

.hashtags { color: var(--text-secondary); }
.hashtags .tag { white-space: nowrap; }

/* ---- 案内ページ（メニューから遷移） ---- */
.info-page {
  position: relative;
  z-index: 1;
  max-width: 760px;
  margin: 0 auto;
  padding: 16px 20px 40px;
  background: var(--panel-bg);
}
.back-link {
  display: inline-block;
  padding: 4px 0;
  font-size: 0.8125rem;
  color: var(--text-secondary);
  text-decoration: none;
}
.back-link:hover { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
.info-title {
  position: relative;
  margin: 16px 0 8px;
  padding-bottom: 12px;
  font-size: 1.5rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: var(--text);
  border-bottom: 1px solid var(--hairline);
}
.info-title::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 48px;
  height: 3px;
  background: var(--primary);
}
.info-body h3 {
  margin: 32px 0 8px;
  font-size: 1rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--primary);
}
.info-body p, .info-body li {
  font-size: 0.9375rem;
  letter-spacing: 0.04em;
  line-height: 1.9;
}
.info-body p { margin: 8px 0; }
.info-body ul { padding-left: 1.25em; margin: 8px 0; }
.info-body li { margin-bottom: 4px; }
.info-body li::marker { color: var(--primary); }
.info-body a { color: var(--primary); text-underline-offset: 3px; }
.info-body a:hover { color: var(--primary-hover); }

.source-list { list-style: none; padding: 0 !important; }
.source-list li {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 4px 12px;
  margin: 0;
  padding: 12px 0;
  border-bottom: 1px solid var(--hairline);
}
.source-name { font-weight: 500; color: var(--text); text-decoration: none; }
a.source-name { color: var(--text); }
.source-feeds { display: flex; flex-wrap: wrap; gap: 4px 12px; }
.source-feeds a {
  font-size: 0.875rem;
  color: var(--text-secondary);
  text-decoration: none;
}
.source-name:hover, .source-feeds a:hover { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
.source-note {
  font-size: 0.75rem;
  color: var(--text-muted);
  border: 1px solid var(--hairline);
  border-radius: 0;
  padding: 0 8px;
}

.info-footer-nav {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
  margin-top: 40px;
}
.back-button {
  display: inline-flex;
  align-items: center;
  gap: 16px;
  height: 44px;
  padding: 0 20px;
  border-radius: 0;
  background: var(--primary);
  color: var(--on-primary);
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-decoration: none;
}
.back-button::after { content: "›"; font-size: 1.1em; }
.back-button:hover { background: var(--primary-hover); }
.back-button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.info-links { display: flex; flex-wrap: wrap; gap: 8px; }
.info-links a {
  display: inline-flex;
  align-items: center;
  height: 32px;
  padding: 0 12px;
  border: 1px solid var(--hairline);
  border-radius: 0;
  background: var(--card-bg);
  font-size: 0.8125rem;
  color: var(--text);
  text-decoration: none;
}
.info-links a:hover { color: var(--primary); border-color: var(--primary); }

/* ---- フッター ---- */
.copyright {
  position: relative;
  z-index: 1;
  max-width: 760px;
  margin: 0 auto;
  padding: 12px 16px 32px;
  font-family: var(--font-en);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  text-align: center;
  background: var(--panel-bg);
}

@media (min-width: 720px) {
  .site-header { padding: 24px 32px 20px; }
  .site-title { font-size: 2.25rem; }
  .header-cut { width: 104px; }
  .header-cut::before { width: 52px; }
  .tabbar { padding: 12px 32px; }
}

#tab-all:checked ~ .panels #panel-all { display: block; }
{% for c in categories %}#tab-{{ c.id }}:checked ~ .panels #panel-{{ c.id }} { display: block; }
{% endfor %}#tab-bookmark:checked ~ .panels #panel-bookmark { display: block; }

/* 選択中タブのハイライト（主色の塗り） */
#tab-all:checked ~ .tabbar label[for="tab-all"],
{% for c in categories %}#tab-{{ c.id }}:checked ~ .tabbar label[for="tab-{{ c.id }}"],
{% endfor %}#tab-bookmark:checked ~ .tabbar label[for="tab-bookmark"] {
  background: var(--primary);
  color: var(--on-primary);
  border-color: var(--primary);
}
