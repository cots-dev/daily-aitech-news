<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{% block title %}Daily AI/Tech News{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/style.css">
</head>
<body>
<header class="site-header">
  <div class="header-top">
    <h1 class="site-title"><a href="index.html">Daily AI/Tech News</a></h1>
    <details class="site-menu">
      <summary class="menu-button" aria-label="メニューを開く">
        <svg class="icon-open" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
        <svg class="icon-close" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
      </summary>
      <nav class="menu-panel" aria-label="サイトメニュー">
        <a class="menu-item menu-item-top" href="index.html"{% if current_page == "index" %} aria-current="page"{% endif %}>記事一覧（TOP）</a>
        {% for p in info_pages %}
        <a class="menu-item" href="{{ p.slug }}.html"{% if current_page == p.slug %} aria-current="page"{% endif %}>{{ p.label }}</a>
        {% endfor %}
      </nav>
    </details>
  </div>
  <p class="subtitle">毎朝6時更新｜Windows・Copilot・M365の最新機能＆活用Tipsをお届け</p>
  <div class="header-meta">
    <span class="date">Last updated：{{ date_display }}</span>
  </div>
</header>

{% block content %}{% endblock %}

<p class="copyright">© 2026 Daily AI/Tech News</p>

{% block scripts %}<script defer src="assets/app.js"></script>{% endblock %}
</body>
</html>
