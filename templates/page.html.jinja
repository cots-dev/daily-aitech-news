{% extends "base.html.jinja" %}

{% macro article_item(a) %}
<li>
  <div class="article-row">
    <div class="article-text">
      {% if a.howto or a.is_english %}
      <div class="badges">
        {%- if a.howto %}<span class="badge badge-howto">すぐ試せる</span>{% endif -%}
        {%- if a.is_english %}<span class="badge badge-en" title="英語の記事です。Google翻訳で日本語に訳して開きます">英語・翻訳で開く</span>{% endif -%}
      </div>
      {% endif %}
      <a class="article-link" href="{{ a.open_url }}" target="_blank" rel="noopener">{{ a.title_ja or a.title }}</a>
      <div class="meta">{{ a.published_display }}{% if a.source %} ・ {{ a.source }}{% endif %}{% if a.hashtags %} ・ <span class="hashtags">{% for h in a.hashtags %}<span class="tag">#{{ h }}</span>{% if not loop.last %} {% endif %}{% endfor %}</span>{% endif %}</div>
    </div>
    <div class="article-side">
      {% if a.thumbnail %}
      <a href="{{ a.open_url }}" target="_blank" rel="noopener" class="thumb-link">
        <img class="article-thumb" src="{{ a.thumbnail }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('.thumb-link').remove()">
      </a>
      {% endif %}
      <button type="button" class="bookmark-btn" data-id="{{ a.id }}" aria-pressed="false" aria-label="ブックマーク"><svg class="star-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" stroke-width="1.5" stroke-linejoin="round"/></svg></button>
    </div>
  </div>
</li>
{% endmacro %}

{% block content %}
<div class="tabs-wrapper">
  <input type="radio" name="tabs" id="tab-all" class="tab-input" checked>
  {% for c in categories %}
  <input type="radio" name="tabs" id="tab-{{ c.id }}" class="tab-input">
  {% endfor %}
  <input type="radio" name="tabs" id="tab-bookmark" class="tab-input">

  <div class="tabbar">
    <label for="tab-all" class="tab-label">総合</label>
    {% for c in categories %}
    <label for="tab-{{ c.id }}" class="tab-label">{{ c.label }}</label>
    {% endfor %}
    <label for="tab-bookmark" class="tab-label">ブックマーク</label>
  </div>

  <main class="panels">
    <section id="panel-all" class="panel">
      <ul class="article-list">
        {% for a in articles %}
        {{ article_item(a) }}
        {% else %}
        <li class="empty">この日の記事はまだありません</li>
        {% endfor %}
      </ul>
    </section>

    {% for c in categories %}
    <section id="panel-{{ c.id }}" class="panel">
      <ul class="article-list">
        {% for a in articles if c.id in a.tags %}
        {{ article_item(a) }}
        {% else %}
        <li class="empty">該当する記事はまだありません</li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}

    <section id="panel-bookmark" class="panel">
      <ul class="article-list">
        <li class="empty">読み込み中...</li>
      </ul>
    </section>
  </main>
</div>
{% endblock %}

{% block scripts %}
<script type="application/json" id="all-articles-data">{{ all_articles_json | safe }}</script>
{{ super() }}
{% endblock %}
